# Bartz settings. Copy to .env and fill in; .env is never committed (see .gitignore).
# Values marked change-me are secrets: pick long random ones (e.g. `openssl rand -base64 24`).

# --- Images (built by ./build.sh, loaded on the Pi with: docker load -i l2j-server-arm64.tar.gz)
L2J_IMAGE=l2j-server:latest
# SITE_IMAGE=l2j-site:latest

# --- Server address
# The address game clients are sent to after login: the Pi's LAN IP for LAN play (e.g. 192.168.1.50), or a DNS-only
# name pointing at your home IP for internet play (e.g. play.example.com). 127.0.0.1 for testing on one machine.
PUBLIC_HOST=127.0.0.1
# Time zone of the servers (sieges, Olympiad, gift box weeks).
# TZ=UTC

# --- Database (written into the database on the first start: change them before it)
DB_USER=l2j
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
# The website's user: reads the game, creates accounts and changes only their password and email (dbinstall)
WEB_DB_PASSWORD=change-me-web
# The website's own database (l2web), created by dbinstall
L2WEB_DB_PASSWORD=change-me-site

# --- Java memory (the game server uses ~3 GB with geodata)
LOGIN_JAVA_OPTS=-Xms128m -Xmx256m
GAME_JAVA_OPTS=-Xms1g -Xmx3g

# --- Login server
# True: logging in with a new name creates the account. False: accounts are created on the website only (with an email).
AUTO_CREATE_ACCOUNTS=True

# --- Website
SITE_PORT=8080
# Laravel key (secret; changing it signs everyone out). Generate one with:
#   docker run --rm --entrypoint php l2j-site:latest artisan key:generate --show
SITE_APP_KEY=base64:change-me
# Public address of the website (links in emails and in game). Default: http://<PUBLIC_HOST>:<SITE_PORT>
# WEBSITE_URL=https://bartz.example.com
# The weekly gift box in the player area
GIFT_BOX_ENABLED=true

# --- Public website through a Cloudflare Tunnel (optional)
# COMPOSE_PROFILES=public
# CF_TUNNEL_TOKEN=change-me
# The tunnel reaches the site over Docker's network: trust it for the visitors' real IPs.
# TRUSTED_PROXIES=172.16.0.0/12

# --- Email for registration and password resets (optional; without it they stay closed)
# Amazon SES:  MAIL_HOST=email-smtp.<region>.amazonaws.com with its SMTP credentials
# Resend:      MAIL_HOST=smtp.resend.com, MAIL_USERNAME=resend, MAIL_PASSWORD=<API key>
# MAIL_MAILER=smtp
# MAIL_HOST=email-smtp.eu-west-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=change-me
# MAIL_PASSWORD=change-me
# MAIL_FROM_ADDRESS=no-reply@example.com
# MAIL_FROM_NAME=Bartz

# --- Bot check on registration and password reset: Cloudflare Turnstile (optional)
# TURNSTILE_SITE_KEY=change-me
# TURNSTILE_SECRET_KEY=change-me
